// Prisma schema — Discord Giveaway Bot
// MariaDB spricht das MySQL-Protokoll -> provider = "mysql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GuildSettings {
  guildId       String   @id // Discord Guild Snowflake
  lang          String   @default("en")
  embedColor    String   @default("#00e676") // Hex (MSK Grün)
  buttonEmoji   String   @default("🎉")
  buttonStyle   String   @default("PRIMARY") // PRIMARY|SECONDARY|SUCCESS|DANGER
  blacklist     String   @default("[]") @db.Text // JSON-Array von Role-IDs (dürfen NICHT teilnehmen)
  whitelist     String   @default("[]") @db.Text // JSON-Array von Role-IDs (≥1 nötig, leer = keine Pflicht)
  bonusRoles    String   @default("{}") @db.Text // JSON-Objekt RoleId -> Bonus-Lose (gewichtete Ziehung)
  minAccountDays Int     @default(0) // Mindest-Account-Alter in Tagen (0 = aus)
  minMemberDays Int      @default(0) // Mindest-Server-Zugehörigkeit in Tagen (0 = aus)
  managerRole   String? // optional: Rolle, die Giveaways verwalten darf
  notifyRole    String? // optional: Rolle, die beim Start gepingt wird
  logChannel    String? // optional: Channel für Giveaway-Logs
  reminderMinutes Int    @default(0) // "Ending soon"-Reminder X Min. vor Ende (0 = aus)
  claimMessage  String?  @db.Text // optional: Hinweistext in der Gewinner-DM ("So holst du deinen Preis ab")

  // ── Tebex-Store der Guild (für automatische Gewinner-Coupons) ──────────────
  // Jede Guild hat ihren EIGENEN Store, der Bot ist nicht an msk-scripts.de
  // gebunden. Das Plugin-Secret liegt AES-256-GCM-verschlüsselt hier (Schlüssel
  // in TEBEX_SECRET_KEY, also außerhalb der DB), siehe utils/secretBox.js.
  // Nur der Guild-Besitzer darf es setzen, ansehen oder löschen.
  tebexSecret      String?   @db.Text // verschlüsselter Blob "v1:iv:ct:tag", NIE Klartext
  tebexSecretHint  String? // letzte 4 Zeichen, für die maskierte Anzeige
  tebexSecretSetAt DateTime? // wann zuletzt hinterlegt
  tebexPublicToken String? // öffentlicher Headless-Token, nur zum Auflisten der Pakete
  tebexStoreUrl    String? // Store-Adresse für den Einlöse-Link in der Gewinner-DM

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GiveawayTemplate {
  id           Int      @id @default(autoincrement())
  guildId      String
  name         String
  title        String
  description  String   @db.Text
  duration     String // z.B. "1d2h30m"
  winnersCount Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([guildId, name])
}

model Giveaway {
  id           String    @id // kurze öffentliche ID, z.B. "A1B2C3"
  guildId      String
  channelId    String
  messageId    String? // Nachricht mit Embed + Button
  hostId       String // wer hat erstellt
  title        String
  description  String    @db.Text
  prize        String?   @db.Text // optionaler Preis (5. Modal-Feld)
  winnersCount Int       @default(1)
  endAt        DateTime
  status       String    @default("ACTIVE") // ACTIVE | PAUSED | ENDED | CANCELLED
  pausedAt     DateTime? // Zeitpunkt der Pausierung (zum Verlängern von endAt beim Resume)
  reminderAt   DateTime? // Zeitpunkt für den "Ending soon"-Reminder (null = kein Reminder)
  reminderSent Boolean   @default(false) // ob der Reminder schon gepostet wurde
  blacklistRoles String  @default("[]") @db.Text // JSON-Array: zusätzliche Blacklist-Rollen NUR für dieses Giveaway
  whitelistRoles String  @default("[]") @db.Text // JSON-Array: zusätzliche Whitelist-Rollen NUR für dieses Giveaway
  bonusRoles     String  @default("{}") @db.Text // JSON-Objekt RoleId->Bonus-Lose NUR für dieses Giveaway (additiv zu Guild)
  // ── Automatischer Tebex-Coupon für die Gewinner ────────────────────────────
  // Pro Giveaway konfiguriert (nur im Web-Dashboard). Jeder Gewinner bekommt
  // einen EIGENEN Code. couponPercent = null schaltet das Feature für dieses
  // Giveaway ab.
  couponPercent   Int? // Rabatt in Prozent (1-100)
  couponPackages  String @default("[]") @db.Text // JSON-Array von Tebex-Paket-IDs; leer = ganzer Warenkorb
  couponValidDays Int? // Gültigkeit in Tagen ab Ziehung; null = läuft nie ab

  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  entries Entry[]
  winners Winner[]
  coupons GiveawayCoupon[]

  @@index([guildId, status])
  @@index([status, endAt])
}

/// Ein ausgestellter Tebex-Coupon, ein Datensatz pro Gewinner.
/// `tebexId` wird gebraucht, um den Code beim Reroll wieder zu widerrufen —
/// sonst behielte ein ersetzter Gewinner seinen Rabatt.
model GiveawayCoupon {
  giveawayId String
  userId     String
  code       String
  tebexId    Int? // ID im Tebex-Store, für den Widerruf
  percent    Int // was tatsächlich ausgestellt wurde
  expiresAt  DateTime? // null = läuft nie ab
  revokedAt  DateTime? // beim Reroll gesetzt
  createdAt  DateTime  @default(now())
  giveaway   Giveaway  @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@id([giveawayId, userId])
  @@index([code])
}

model Entry {
  giveawayId String
  userId     String
  joinedAt   DateTime @default(now())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@id([giveawayId, userId])
}

model Winner {
  giveawayId String
  userId     String
  rerolled   Boolean  @default(false)
  pickedAt   DateTime @default(now())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@id([giveawayId, userId])
}
