# ─── Discord ──────────────────────────────────────────────
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Optional: Guild-ID für schnelles Dev-Deploy der Slash-Commands.
# Leer lassen für globales Deploy (kann bis zu 1h dauern).
GUILD_ID=

# ─── Datenbank (MariaDB / MySQL-Protokoll) ────────────────
DATABASE_URL="mysql://root:root@localhost:3306/giveaway_bot"

# Eigene Datenbank für `npm test`. Ohne diese Variable werden alle Tests
# übersprungen, die eine Datenbank brauchen. MUSS sich von DATABASE_URL
# unterscheiden: die Scheduler-Tests beenden jedes fällige Giveaway in der
# Datenbank, auf die sie zeigen. Einmalig anlegen mit `npm run test:db`.
TEST_DATABASE_URL="mysql://root:root@localhost:3306/giveaway_bot_test"

# ─── Web-Dashboard: Steuer-Endpunkt (msk-shop) ────────────
# Schlanker HTTP-Server, NUR an 127.0.0.1 gebunden. Der msk-shop ruft ihn auf,
# um Giveaways/Einstellungen zu verwalten. Leer lassen = Dashboard-Steuerung aus.
CONTROL_PORT=8787
CONTROL_SECRET=                 # 32-byte hex; muss im msk-shop als GIVEAWAY_CONTROL_SECRET identisch sein

# ─── Öffentliche Ergebnis-Seite (msk-shop) ────────────────
# Beim Beenden pusht der Bot Gewinner + Teilnehmerzahl an den Shop, der daraus
# eine öffentliche Ergebnis-Seite hostet. Leer lassen = kein Ergebnis-Link.
RESULT_PUBLISH_URL=https://www.msk-scripts.de/api/giveaway-result/publish
RESULT_PUBLISH_SECRET=          # 32-byte hex; muss im msk-shop als GIVEAWAY_RESULT_SECRET identisch sein
