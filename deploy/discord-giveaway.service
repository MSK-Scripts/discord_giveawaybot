[Unit]
Description=Discord Giveaway Bot (MSK Scripts)
Documentation=https://github.com/MSK-Scripts/discord_giveawaybot
After=network-online.target mariadb.service
Wants=network-online.target

# Crash-Loop-Bremse: max. StartLimitBurst Neustarts in StartLimitIntervalSec.
# (Diese Keys gehören in [Unit], NICHT in [Service].)
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=discord
Group=discord
WorkingDirectory=/opt/discord_giveaway

# Pfad ggf. an `which node` anpassen (Node 22). Bei nvm: absoluter Pfad zur node-Binary.
ExecStart=/usr/bin/node src/index.js

# Lädt DISCORD_TOKEN / CLIENT_ID / DATABASE_URL etc. (Datei NICHT ins Repo!)
EnvironmentFile=/opt/discord_giveaway/.env
Environment=NODE_ENV=production

Restart=on-failure
RestartSec=5

# Logs gehen an journald: `journalctl -u discord-giveaway -f`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-giveaway

# Hardening (optional, bei Problemen einzeln deaktivieren)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/discord_giveaway

[Install]
WantedBy=multi-user.target
