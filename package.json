{
  "name": "discord-giveaway-bot",
  "version": "1.10.0",
  "description": "Discord Giveaway Bot (discord.js v14, Prisma/MariaDB, mehrsprachig) — MSK Scripts",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node deploy-commands.js",
    "deploy:global": "node deploy-commands.js --global",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "smoke": "node scripts/smoke.js",
    "i18n:check": "node scripts/i18n-check.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:db": "node scripts/test-db-setup.js"
  },
  "author": "Moritz Kohm (MSK Scripts)",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "overrides": {
    "undici": "^6.28.0"
  }
}
